# Copy to .env and adjust. Environment variables override config.yaml.
# Required: the RDP host to forward connections to.
RDP_PROXY_TARGET_HOST=192.0.2.10
RDP_PROXY_TARGET_PORT=3389

RDP_PROXY_LISTEN_HOST=0.0.0.0
RDP_PROXY_LISTEN_PORT=3389
RDP_PROXY_CONNECT_TIMEOUT_MS=10000
RDP_PROXY_TCP_KEEPALIVE=true
RDP_PROXY_TCP_NODELAY=true
RDP_PROXY_BACKLOG=1024

# trace | debug | info | warn | error
RDP_PROXY_LOG_LEVEL=info
# text | json
RDP_PROXY_LOG_FORMAT=text

# Optional
RDP_PROXY_CONNECTION_LIMIT=1000
# Comma-separated IPs or CIDRs allowed to connect; empty = allow all.
RDP_PROXY_ALLOWED_IPS=198.51.100.0/24,203.0.113.5
